{
  "name": "mcp-hub",
  "version": "1.0.0",
  "description": "Un sitio para tus MCPs y tus agentes de programación (Claude Code, Codex, OpenCode, Gemini CLI, Cursor)",
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder --publish never"
  },
  "keywords": [],
  "author": {
    "name": "orele2013",
    "email": "orelappertmartinez@gmail.com"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "imapflow": "^2.2.1",
    "jszip": "^3.10.2",
    "mailparser": "^3.9.33",
    "node-pty": "^1.1.0",
    "nodemailer": "^10.0.13",
    "pptxgenjs": "^4.0.1",
    "puppeteer-core": "^25.12.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "smol-toml": "^1.9.0",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron@44.5.1": true,
    "electron-winstaller": false
  },
  "bin": {
    "mcp-hub": "bin/mcp-hub"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "productName": "MCP Hub",
  "homepage": "https://github.com/orele2013/mcp-hub",
  "repository": {
    "type": "git",
    "url": "https://github.com/orele2013/mcp-hub.git"
  },
  "build": {
    "appId": "net.orele.mcphub",
    "productName": "MCP Hub",
    "copyright": "© 2026 orele2013",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!android/**",
      "!dist/**",
      "!.impeccable/**",
      "!.github/**",
      "!test/**",
      "!build/**",
      "!**/*.md",
      "!*.tar.gz"
    ],
    "asar": false,
    "npmRebuild": true,
    "artifactName": "MCP-Hub-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "synopsis": "MCPs y agentes de programación en un solo sitio"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MCP Hub",
      "artifactName": "MCP-Hub-${version}-windows-${arch}-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "artifactName": "MCP-Hub-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "MCP Hub ${version}"
    }
  }
}
